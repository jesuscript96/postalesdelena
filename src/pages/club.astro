---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site.js';
import { IMG } from '../lib/img.js';

const perks = [
  { t: 'Una carta semanal', d: 'Cada domingo, un rincón con alma, un hotel que enamora y un plan para viajar despacio.' },
  { t: 'Guías con descuento', d: 'Precios especiales y acceso anticipado a cada nueva guía antes que nadie.' },
  { t: 'Rincones secretos', d: 'Lugares que no comparto en redes: los guardo solo para la comunidad del Club.' },
  { t: 'Comunidad', d: 'Un grupo de viajeros que, como tú, prefieren la calidad a la prisa.' },
];
const testimonials = [
  { q: 'Cada domingo espero la carta de Elena como quien espera una postal de una amiga.', a: 'María, Madrid' },
  { q: 'Gracias al Club descubrí un hotel en la Toscana que ha sido el viaje de mi vida.', a: 'Carlos, Valencia' },
];
---

<Base title="El Club" description="Únete al club: una carta semanal con rincones con alma, hoteles que enamoran y planes para viajar despacio.">
  <section class="relative min-h-[80vh] flex items-center overflow-hidden">
    <img src={IMG.como} alt="El Club" class="absolute inset-0 w-full h-full object-cover kenburns" />
    <div class="hero-overlay"></div>
    <div class="container-x relative z-10 text-cream max-w-2xl">
      <p class="eyebrow-line text-cream/75 mb-4 text-shadow-soft">Members Only · {SITE.name} Mail</p>
      <h1 class="font-serif text-5xl md:text-7xl leading-[0.98] text-shadow-hero">Únete al <span class="italic" style="color:#EBD4B8">Club</span></h1>
      <p class="mt-6 text-cream/85 leading-relaxed text-lg">Una comunidad para quienes viajan despacio. Inspiración, rincones secretos y ventajas exclusivas, directo a tu correo.</p>
      <form class="mt-8 flex max-w-md border-b border-cream/40" onsubmit="this.nextElementSibling.classList.remove('hidden');return false;">
        <input required type="email" placeholder="Tu correo electrónico" class="bg-transparent flex-1 py-3 outline-none placeholder-cream/50 text-cream" />
        <button class="font-sans uppercase tracking-widest text-[11px] px-3 hover:text-clay">Unirme →</button>
      </form>
      <p class="hidden text-cream/90 text-sm mt-4">✓ ¡Bienvenida al Club! (Demo — conéctalo a tu newsletter: MailerLite o Beehiiv.)</p>
    </div>
  </section>

  <section class="container-x py-24">
    <div class="grid md:grid-cols-2 gap-x-16 gap-y-14">
      {perks.map((p, i) => (
        <div class="flex gap-6">
          <span class="font-serif text-3xl text-clay">{String(i + 1).padStart(2, '0')}</span>
          <div><h3 class="font-serif text-2xl">{p.t}</h3><p class="text-stone mt-2 leading-relaxed">{p.d}</p></div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-sand py-24">
    <div class="container-x grid md:grid-cols-2 gap-10">
      {testimonials.map((t) => (
        <blockquote class="text-center px-6">
          <p class="font-serif text-2xl md:text-3xl leading-snug italic">“{t.q}”</p>
          <footer class="eyebrow mt-6">{t.a}</footer>
        </blockquote>
      ))}
    </div>
  </section>

  <section class="container-x py-24 text-center max-w-xl mx-auto">
    <p class="eyebrow mb-3">Gratis para siempre</p>
    <h2 class="font-serif text-4xl md:text-5xl">Empieza a viajar despacio hoy</h2>
    <form class="mt-8 flex max-w-md mx-auto border-b border-ink/30" onsubmit="this.nextElementSibling.classList.remove('hidden');return false;">
      <input required type="email" placeholder="Tu correo electrónico" class="bg-transparent flex-1 py-3 outline-none" />
      <button class="font-sans uppercase tracking-widest text-[11px] px-3 hover:text-clay">Unirme →</button>
    </form>
    <p class="hidden text-stone text-sm mt-4">✓ ¡Bienvenida al Club!</p>
  </section>
</Base>
