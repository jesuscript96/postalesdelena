---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE } from '../data/site.js';
import { IMG } from '../lib/img.js';

const values = [
  { t: 'Despacio', d: 'Menos lugares, más presentes. La belleza aparece cuando dejas de correr.' },
  { t: 'Auténtico', d: 'Lo local antes que lo turístico. La gente, la comida y las historias reales.' },
  { t: 'Con alma', d: 'Lujo sin pretensión: detalles, calma y lugares que dejan huella.' },
];
---

<Base title="Sobre Elena" description="La historia detrás de VIVIR DESPACIO: viajar despacio, con alma y sin pretensiones.">
  <section class="container-x pt-28 pb-16 grid md:grid-cols-2 gap-14 items-center">
    <div>
      <p class="eyebrow mb-4">La historia</p>
      <h1 class="font-serif text-5xl md:text-6xl leading-[1]">Hola, soy {SITE.author}</h1>
      <p class="mt-6 text-stone leading-relaxed text-lg">
        Llevo años recorriendo Europa con una idea sencilla: los viajes más bonitos no son
        los que llenan una lista, sino los que se viven despacio.
      </p>
      <p class="mt-4 text-stone leading-relaxed">
        {SITE.name} nació para inspirar descubrimientos basados en experiencias auténticas e
        inmersivas, con un enfoque de viaje lento, con toques de lujo pero sin ninguna
        pretensión. Creo en el crecimiento personal que surge de conectar de verdad con el
        entorno y la forma de vida de cada lugar.
      </p>
    </div>
    <div class="aspect-[4/5] overflow-hidden bg-sand">
      <img src={IMG.portrait} alt={SITE.author} class="w-full h-full object-cover" />
    </div>
  </section>

  <section class="bg-sand py-24">
    <div class="container-x grid md:grid-cols-3 gap-10">
      {values.map((v) => (
        <div class="text-center">
          <h3 class="font-serif text-3xl">{v.t}</h3>
          <p class="text-stone mt-3 leading-relaxed">{v.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-x py-24 grid md:grid-cols-2 gap-14 items-center">
    <div class="aspect-[4/3] overflow-hidden bg-sand order-2 md:order-1">
      <img src={IMG.italyFood} alt="Gastronomía local" class="w-full h-full object-cover" />
    </div>
    <div class="order-1 md:order-2">
      <p class="eyebrow mb-4">Mi filosofía</p>
      <h2 class="font-serif text-4xl md:text-5xl leading-tight">El lujo verdadero es el tiempo</h2>
      <p class="mt-6 text-stone leading-relaxed">
        No necesitas ver diez ciudades en una semana. Necesitas una mañana sin planes, un
        mercado, una conversación con quien vive allí. Eso es lo que intento transmitir en cada
        guía y en cada viaje que diseño: el arte de estar presente.
      </p>
      <div class="mt-8 flex gap-4">
        <a href="/guias" class="btn-dark">Ver mis guías</a>
        <a href="/lifestyle" class="btn-outline">Viajar conmigo</a>
      </div>
    </div>
  </section>

  <Newsletter />
</Base>
