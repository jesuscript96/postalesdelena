---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE } from '../data/site.js';
import { IMG } from '../lib/img.js';

const services = [
  { n: '01', title: 'Estancias escogidas', text: 'Acceso a los mejores hoteles y villas, con detalles y ventajas que no encontrarás reservando por tu cuenta.', img: IMG.hotel },
  { n: '02', title: 'Experiencias memorables', text: 'Encuentros con productores, artesanos y guías locales para vivir el destino desde dentro.', img: IMG.winery },
  { n: '03', title: 'Viaje a medida', text: 'Tu viaje diseñado y coordinado de principio a fin, desde la primera idea hasta que vuelves a casa.', img: IMG.venice },
];
const steps = [
  { n: '1', t: 'Nos escribes', d: 'Cuéntame cómo sueñas tu viaje: fechas, ritmo, intereses y presupuesto aproximado.' },
  { n: '2', t: 'Diseño tu ruta', d: 'Recibes una propuesta personalizada con alojamientos, experiencias e itinerario día a día.' },
  { n: '3', t: 'Ajustamos juntas', d: 'Refinamos cada detalle hasta que sea exactamente el viaje que quieres.' },
  { n: '4', t: 'Solo disfrutas', d: 'Viajas con todo resuelto y con soporte durante el camino. Tú solo tienes que estar presente.' },
];
const packages = [
  { name: 'Ruta a medida', price: 'desde 150€', text: 'Itinerario personalizado y reservas sugeridas para que viajes por tu cuenta con todo pensado.', features: ['Itinerario día a día', 'Selección de hoteles', 'Mapa y reservas sugeridas'] },
  { name: 'Viaje coordinado', price: 'desde 390€', text: 'Diseño completo y coordinación de todas las reservas. El plan sin complicaciones.', features: ['Todo lo anterior', 'Gestión de reservas', 'Experiencias privadas', 'Soporte durante el viaje'], featured: true },
  { name: 'Retiro Slow', price: 'a consultar', text: 'Viajes en grupo reducido y retiros de bienestar organizados por Elena a lo largo del año.', features: ['Grupo reducido', 'Programa cuidado', 'Todo incluido'] },
];
---

<Base title="Travel Lifestyle" description="Viajes a medida, experiencias curadas y retiros de bienestar diseñados por Elena para viajar despacio.">
  <section class="relative h-[70vh] min-h-[460px] flex items-center overflow-hidden">
    <img src={IMG.winery} alt="Experiencias de viaje" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-ink/45"></div>
    <div class="container-x relative z-10 text-cream max-w-2xl">
      <p class="eyebrow text-cream/80 mb-4">{SITE.author} · Travel Lifestyle</p>
      <h1 class="font-serif text-5xl md:text-7xl leading-[0.98]">No solo un viaje: una forma de vivir</h1>
      <p class="mt-6 text-cream/85 leading-relaxed">Diseño viajes a medida, experiencias curadas y retiros de bienestar para quienes entienden que el lujo verdadero es el tiempo, la calma y lo auténtico.</p>
      <a href="#solicitar" class="btn-light mt-8">Solicitar mi viaje</a>
    </div>
  </section>

  <!-- Servicios -->
  <section class="container-x py-24">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="eyebrow mb-3">Cómo puedo ayudarte</p>
      <h2 class="font-serif text-4xl md:text-5xl">Tres formas de viajar conmigo</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      {services.map((s) => (
        <div class="group">
          <div class="aspect-[4/3] overflow-hidden bg-sand">
            <img src={s.img} alt={s.title} loading="lazy" class="w-full h-full object-cover transition-transform duration-[1.2s] ease-slow group-hover:scale-105" />
          </div>
          <span class="font-serif text-2xl text-clay mt-5 inline-block">{s.n}</span>
          <h3 class="font-serif text-2xl mt-1">{s.title}</h3>
          <p class="text-sm text-stone mt-2 leading-relaxed">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Cómo funciona -->
  <section class="bg-sand py-24">
    <div class="container-x">
      <div class="text-center mb-16"><p class="eyebrow mb-3">El proceso</p><h2 class="font-serif text-4xl md:text-5xl">Cómo funciona</h2></div>
      <div class="grid md:grid-cols-4 gap-10">
        {steps.map((s) => (
          <div>
            <div class="w-12 h-12 rounded-full border border-ink flex items-center justify-center font-serif text-xl">{s.n}</div>
            <h3 class="font-serif text-2xl mt-5">{s.t}</h3>
            <p class="text-sm text-stone mt-2 leading-relaxed">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Paquetes -->
  <section class="container-x py-24">
    <div class="text-center mb-16"><p class="eyebrow mb-3">Servicios</p><h2 class="font-serif text-4xl md:text-5xl">Elige cómo empezar</h2></div>
    <div class="grid md:grid-cols-3 gap-8">
      {packages.map((p) => (
        <div class:list={['border p-8 flex flex-col', p.featured ? 'border-ink bg-ink text-cream' : 'border-line']}>
          <h3 class="font-serif text-3xl">{p.name}</h3>
          <p class:list={['font-serif text-xl mt-2', p.featured ? 'text-clay' : 'text-clay']}>{p.price}</p>
          <p class:list={['text-sm mt-4 leading-relaxed', p.featured ? 'text-cream/80' : 'text-stone']}>{p.text}</p>
          <ul class="mt-6 space-y-2 flex-1">
            {p.features.map((f) => <li class:list={['text-sm flex gap-2', p.featured ? 'text-cream/90' : 'text-ink']}><span class="text-clay">·</span>{f}</li>)}
          </ul>
          <a href="#solicitar" class:list={[p.featured ? 'btn-light' : 'btn-outline', 'mt-8']}>Solicitar</a>
        </div>
      ))}
    </div>
  </section>

  <!-- Formulario de solicitud -->
  <section id="solicitar" class="bg-olive text-cream py-24">
    <div class="container-x max-w-2xl">
      <div class="text-center mb-12">
        <p class="eyebrow text-cream/60 mb-3">Empecemos</p>
        <h2 class="font-serif text-4xl md:text-5xl">Cuéntame tu viaje soñado</h2>
        <p class="mt-4 text-cream/80">Responde en menos de 48 horas con una primera propuesta, sin compromiso.</p>
      </div>
      <form class="grid gap-5" onsubmit="this.querySelector('[data-ok]').classList.remove('hidden');return false;">
        <div class="grid md:grid-cols-2 gap-5">
          <input required placeholder="Nombre" class="bg-transparent border-b border-cream/30 py-3 outline-none placeholder-cream/50" />
          <input required type="email" placeholder="Email" class="bg-transparent border-b border-cream/30 py-3 outline-none placeholder-cream/50" />
        </div>
        <div class="grid md:grid-cols-2 gap-5">
          <input placeholder="Destino soñado" class="bg-transparent border-b border-cream/30 py-3 outline-none placeholder-cream/50" />
          <input placeholder="Fechas aproximadas" class="bg-transparent border-b border-cream/30 py-3 outline-none placeholder-cream/50" />
        </div>
        <textarea rows="4" placeholder="Cuéntame cómo imaginas tu viaje…" class="bg-transparent border-b border-cream/30 py-3 outline-none placeholder-cream/50"></textarea>
        <button class="btn-light justify-self-start mt-2">Enviar solicitud</button>
        <p data-ok class="hidden text-cream/90 text-sm">✓ ¡Gracias! Te responderé muy pronto. (Formulario de demostración — conéctalo a tu email o a Formspree.)</p>
      </form>
    </div>
  </section>

  <Newsletter dark={false} eyebrow="El Club" title="¿Aún no viajas conmigo?" text="Suscríbete y recibe inspiración, rincones con alma e ideas para tu próximo viaje." />
</Base>
