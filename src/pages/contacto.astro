---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site.js';

const field = 'w-full bg-transparent border-b border-line py-3 outline-none focus:border-ink mt-2';
---

<Base title="Contacto" description="¿Hablamos? Escríbeme si tienes alguna pregunta sobre las guías, quieres compartir una recomendación o colaborar.">
  <section class="container-x pt-32 md:pt-36 pb-12">
    <div class="max-w-2xl mx-auto">
      <h1 class="font-serif text-5xl md:text-6xl">¿Hablamos?</h1>
      <p class="mt-6 text-stone leading-relaxed md:text-lg">
        Si tienes alguna pregunta sobre las guías, quieres compartir una recomendación, estás
        interesado/a en colaborar o simplemente quieres ponerte en contacto, estaré encantada de
        leerte.
      </p>
      <p class="mt-6 font-serif italic text-2xl">Escríbeme y hablamos.</p>

      <!-- Formulario (demo): conéctalo a Formspree, Getform o a tu email -->
      <form class="grid gap-7 mt-12" onsubmit="this.querySelector('[data-ok]').classList.remove('hidden');this.reset();return false;">
        <label class="block"><span class="eyebrow">Nombre</span><input name="nombre" required autocomplete="name" class={field} /></label>
        <label class="block"><span class="eyebrow">Email</span><input name="email" required type="email" autocomplete="email" class={field} /></label>
        <label class="block"><span class="eyebrow">Mensaje</span><textarea name="mensaje" required rows="6" class={field}></textarea></label>
        <button class="btn-dark justify-self-start">Enviar</button>
        <p data-ok class="hidden text-olive text-sm">✓ ¡Gracias! Te responderé pronto.</p>
      </form>

      <p class="mt-16 pt-10 border-t border-line text-stone">
        También puedes encontrarme en Instagram
        <a href={SITE.social.instagram} target="_blank" rel="noopener" class="text-ink link-underline">{SITE.instagramHandle}</a>
      </p>
    </div>
  </section>
</Base>
