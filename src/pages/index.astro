---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GuideCarousel from '../components/GuideCarousel.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE } from '../data/site.js';
import { IMG } from '../lib/img.js';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const italia = guides.filter((g) => g.data.region === 'Italia');
const francia = guides.filter((g) => g.data.region === 'Francia');
const espana = guides.filter((g) => g.data.region === 'España');
const featured = guides.find((g) => g.data.featured) ?? guides[0];

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const seasonal = [
  { title: 'La Toscana', img: IMG.tuscany2, text: 'Colinas doradas, arte y una vida que sabe a vino y pan caliente.', href: '/guias/toscana' },
  { title: 'Provenza', img: IMG.lavender, text: 'Campos de lavanda, mercados y la luz más suave del sur de Francia.', href: '/guias/provenza' },
  { title: 'Los Dolomitas', img: IMG.dolomites, text: 'Naturaleza en estado puro, en la estación en que todo se aquieta.', href: '/guias/dolomitas' },
];
---

<Base>
  <!-- HERO -->
  <section class="relative h-screen min-h-[640px] flex items-end overflow-hidden">
    <img src={IMG.countryside} alt="Paisaje de la Toscana al atardecer"
      class="absolute inset-0 w-full h-full object-cover kenburns" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-ink/10 to-ink/30"></div>
    <div class="container-x relative z-10 pb-24 text-cream">
      <p class="eyebrow text-cream/80 mb-6">Lugares para recorrer despacio</p>
      <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl leading-[0.95] max-w-4xl">
        Viaja despacio,<br />siente cada lugar
      </h1>
      <p class="mt-6 max-w-xl text-cream/85 leading-relaxed">
        Guías de viaje digitales y experiencias lifestyle para descubrir Europa sin prisa:
        itinerarios cuidados, hoteles con alma y los rincones más auténticos.
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a href="/guias" class="btn-light">Ver las guías</a>
        <a href="/lifestyle" class="btn-light">Viajes a medida</a>
      </div>
    </div>
  </section>

  <!-- DESTINOS DE TEMPORADA -->
  <section class="container-x py-24 reveal">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="eyebrow mb-4">Destinos de temporada</p>
      <h2 class="font-serif text-4xl md:text-5xl">Una estación pausada, llena de belleza</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      {seasonal.map((d) => (
        <a href={d.href} class="group block">
          <div class="aspect-[4/5] overflow-hidden bg-sand">
            <img src={d.img} alt={d.title} loading="lazy"
              class="w-full h-full object-cover transition-transform duration-[1.2s] ease-slow group-hover:scale-105" />
          </div>
          <h3 class="font-serif text-2xl mt-5">{d.title}</h3>
          <p class="text-sm text-stone mt-2 leading-relaxed">{d.text}</p>
          <span class="mt-4 inline-block font-sans uppercase tracking-widest text-[11px] text-clay group-hover:text-ink">Explorar la guía →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- CARRUSELES POR PAÍS -->
  <GuideCarousel eyebrow="Todas nuestras guías de" title="Italia" guides={italia} cta={{ label: 'Ver Italia', href: '/destinos/italia' }} />
  <GuideCarousel eyebrow="Todas nuestras guías de" title="Francia" guides={francia} cta={{ label: 'Ver Francia', href: '/destinos/francia' }} />
  <GuideCarousel eyebrow="Todas nuestras guías de" title="España" guides={espana} cta={{ label: 'Ver España', href: '/destinos/espana' }} />

  <!-- LIFESTYLE / SERVICIOS -->
  <section class="bg-sand py-24 reveal">
    <div class="container-x grid md:grid-cols-2 gap-16 items-center">
      <div class="aspect-[4/3] overflow-hidden">
        <img src={IMG.hotel} alt="Hotel con encanto" loading="lazy" class="w-full h-full object-cover" />
      </div>
      <div>
        <p class="eyebrow mb-4">{SITE.author} · Travel Lifestyle</p>
        <h2 class="font-serif text-4xl md:text-5xl leading-tight">Más que guías: una forma de viajar</h2>
        <p class="mt-6 text-stone leading-relaxed">
          Para quienes quieren dar un paso más, {SITE.author} diseña viajes a medida, retiros de
          bienestar y experiencias cuidadas de principio a fin. Estancias escogidas, encuentros
          con productores locales y un ritmo pensado para disfrutar, no para correr.
        </p>
        <div class="mt-8 grid grid-cols-3 gap-6">
          <div><p class="font-serif text-3xl">Estancias</p><p class="text-xs text-stone mt-1">Hoteles y villas con alma</p></div>
          <div><p class="font-serif text-3xl">Experiencias</p><p class="text-xs text-stone mt-1">Cultura y gastronomía local</p></div>
          <div><p class="font-serif text-3xl">A medida</p><p class="text-xs text-stone mt-1">Tu viaje, diseñado para ti</p></div>
        </div>
        <a href="/lifestyle" class="btn-dark mt-9">Descubrir el servicio</a>
      </div>
    </div>
  </section>

  <!-- GUÍA DESTACADA -->
  {featured && (
    <section class="relative py-32 reveal">
      <img src={featured.data.gallery?.[0] ?? featured.data.cover} alt={featured.data.title}
        class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-ink/45"></div>
      <div class="container-x relative z-10 text-cream text-center max-w-2xl mx-auto">
        <p class="eyebrow text-cream/80 mb-4">Guía destacada</p>
        <h2 class="font-serif text-5xl md:text-6xl">{featured.data.title}</h2>
        <p class="mt-5 text-cream/85 leading-relaxed">{featured.data.subtitle}</p>
        <a href={`/guias/${featured.slug}`} class="btn-light mt-8">Ver la guía completa</a>
      </div>
    </section>
  )}

  <!-- EL DIARIO -->
  <section class="container-x py-24 reveal">
    <div class="flex items-end justify-between mb-12">
      <div>
        <p class="eyebrow mb-3">El Diario del Viajero</p>
        <h2 class="font-serif text-4xl md:text-5xl">Historias</h2>
      </div>
      <a href="/diario" class="hidden md:inline font-sans uppercase tracking-widest text-[12px] link-underline">Leer todas</a>
    </div>
    <div class="grid md:grid-cols-3 gap-10">
      {articles.slice(0, 3).map((a) => <ArticleCard article={a} />)}
    </div>
  </section>

  <Newsletter />
</Base>
