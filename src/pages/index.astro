---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import GuideCover from '../components/GuideCover.astro';
import { SITE } from '../data/site.js';
import { IMG } from '../lib/img.js';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base image={IMG.heroHome}>
  <!-- ══════════ PORTADA: solo la foto y el nombre ══════════ -->
  <section class="relative h-screen min-h-[600px] flex flex-col overflow-hidden">
    <img src={IMG.heroHome} alt="Foto de viaje de Elena"
      class="absolute inset-0 w-full h-full object-cover kenburns" />
    <div class="absolute inset-0 bg-gradient-to-b from-ink/35 via-ink/0 to-ink/55"></div>

    <div class="relative z-10 flex-1 flex flex-col items-center justify-end text-center text-cream container-x pb-[16vh]">
      <h1 class="font-serif font-light uppercase tracking-[0.18em] text-cream text-shadow-hero leading-tight"
        style="font-size:clamp(2.2rem,6vw,4.75rem)">
        {SITE.name}
      </h1>
      <p class="mt-4 font-serif italic text-cream/95 text-shadow-soft" style="font-size:clamp(1.15rem,2.2vw,1.7rem)">
        {SITE.tagline}
      </p>
    </div>
  </section>

  <!-- ══════════ GUÍAS DE VIAJE ══════════ -->
  <section id="guias" class="bg-sand py-24 md:py-28 reveal">
    <div class="container-x">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="font-serif uppercase tracking-[0.14em] text-3xl md:text-[2.6rem]">Guías de viaje</h2>
        <p class="mt-6 text-stone leading-relaxed md:text-lg">
          Guías de viaje creadas a partir de experiencias reales y cuidadosamente seleccionadas.
          Rutas, hoteles, restaurantes, lugares especiales y recomendaciones prácticas para
          descubrir cada destino y convertir cada viaje en un recuerdo especial.
        </p>
      </div>

      <div class="mt-16 flex flex-wrap justify-center gap-10 md:gap-20">
        {guides.map((g) => (
          <a href={`/guias#${g.slug}`} class="group block w-[min(80vw,340px)]">
            <GuideCover guide={g} class="transition-transform duration-700 ease-slow group-hover:-translate-y-2" />
            <p class="mt-6 text-center font-sans uppercase tracking-widest text-[12px] text-ink/80 group-hover:text-clay transition-colors">
              Guía de {g.data.title} →
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════ EL DIARIO DE ELENA ══════════ -->
  <section class="container-x py-24 md:py-28 reveal">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="font-serif uppercase tracking-[0.14em] text-3xl md:text-[2.6rem]">El Diario de {SITE.author}</h2>
      <p class="mt-6 text-stone leading-relaxed md:text-lg">
        Historias, escapadas y descubrimientos de mis viajes. Lugares especiales, hoteles con
        encanto, restaurantes, experiencias y recomendaciones cuidadosamente seleccionadas para
        inspirar tus próximos viajes.
      </p>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-12 mt-14">
      {articles.slice(0, 4).map((a) => <ArticleCard article={a} />)}
    </div>

    <div class="mt-12 flex justify-end">
      <a href="/diario" class="btn-outline">Ver +</a>
    </div>
  </section>
</Base>
