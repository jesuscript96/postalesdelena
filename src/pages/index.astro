---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GuideCarousel from '../components/GuideCarousel.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE } from '../data/site.js';
import { IMG } from '../lib/img.js';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const italia = guides.filter((g) => g.data.region === 'Italia');
const francia = guides.filter((g) => g.data.region === 'Francia');
const espana = guides.filter((g) => g.data.region === 'España');
const featured = guides.find((g) => g.data.featured) ?? guides[0];

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const seasonal = [
  { n: '01', title: 'La Toscana', img: IMG.tuscany2, text: 'Colinas doradas, arte y una vida que sabe a vino y pan caliente.', href: '/guias/toscana' },
  { n: '02', title: 'Provenza', img: IMG.lavender, text: 'Campos de lavanda, mercados y la luz más suave del sur de Francia.', href: '/guias/provenza' },
  { n: '03', title: 'Los Dolomitas', img: IMG.dolomites, text: 'Naturaleza en estado puro, en la estación en que todo se aquieta.', href: '/guias/dolomitas' },
];
---

<Base>
  <!-- ══════════ HERO ══════════ -->
  <section class="relative h-screen min-h-[660px] flex flex-col overflow-hidden">
    <img src={IMG.countryside} alt="Paisaje europeo al atardecer"
      class="absolute inset-0 w-full h-full object-cover kenburns" />
    <div class="hero-overlay"></div>

    <!-- Overline superior -->
    <div class="container-x relative z-10 pt-28 md:pt-32">
      <p class="eyebrow-line centered text-cream/75 text-shadow-soft">Est. 2026 · Guías de viaje &amp; lifestyle</p>
    </div>

    <!-- Título centrado -->
    <div class="container-x relative z-10 flex-1 flex flex-col items-center justify-center text-center text-cream">
      <h1 class="font-serif font-light leading-[0.92] text-shadow-hero"
        style="font-size:clamp(3.2rem,10vw,8.5rem)">
        Viaja despacio,<br />
        <span class="italic" style="color:#EBD4B8">siente cada lugar</span>
      </h1>
      <p class="mt-8 max-w-xl text-cream/90 leading-relaxed text-shadow-soft md:text-lg">
        Guías digitales y experiencias lifestyle para descubrir Europa sin prisa:
        itinerarios cuidados, hoteles con alma y los rincones más auténticos.
      </p>
      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a href="/guias" class="btn-solid-light">Ver las guías</a>
        <a href="/lifestyle" class="btn-light">Viajes a medida</a>
      </div>
    </div>

    <!-- Barra inferior -->
    <div class="container-x relative z-10 pb-10 flex items-end justify-between text-cream/80">
      <p class="hidden md:block eyebrow-line text-cream/70 text-shadow-soft">{SITE.tagline}</p>
      <div class="mx-auto md:mx-0 flex flex-col items-center gap-2">
        <span class="eyebrow text-cream/70">Desliza</span>
        <span class="scroll-dot relative block h-8 w-5 rounded-full border border-cream/50"></span>
      </div>
    </div>
  </section>

  <!-- ══════════ MANIFIESTO ══════════ -->
  <section class="container-x py-28 md:py-36 reveal">
    <div class="max-w-4xl mx-auto text-center">
      <p class="eyebrow-line centered mb-8">Nuestra filosofía</p>
      <p class="font-serif text-3xl md:text-[2.7rem] leading-[1.35] text-ink/90">
        Creemos que los viajes más bonitos no son los que <span class="accent">llenan una lista</span>,
        sino los que se viven despacio. Menos lugares, más presentes. Lo <span class="accent">auténtico</span>
        antes que lo turístico. El verdadero lujo es el tiempo.
      </p>
      <div class="mt-10 flex items-center justify-center gap-4">
        <span class="h-px w-12 bg-line"></span>
        <span class="font-serif italic text-xl text-stone">{SITE.author}</span>
        <span class="h-px w-12 bg-line"></span>
      </div>
    </div>
  </section>

  <!-- ══════════ DESTINOS DE TEMPORADA ══════════ -->
  <section class="bg-sand py-24 md:py-28 reveal">
    <div class="container-x">
      <SectionHeading index="01" eyebrow="Destinos de temporada" title="Una estación pausada,<br/>llena de <span class='accent'>belleza</span>" align="center" />
      <div class="grid md:grid-cols-3 gap-8 mt-16">
        {seasonal.map((d) => (
          <a href={d.href} class="group block">
            <div class="relative aspect-[4/5] overflow-hidden bg-cream">
              <img src={d.img} alt={d.title} loading="lazy"
                class="w-full h-full object-cover transition-transform duration-[1.4s] ease-slow group-hover:scale-105" />
              <span class="absolute top-4 left-4 font-serif text-cream text-shadow-soft text-lg">{d.n}</span>
            </div>
            <h3 class="font-serif text-2xl mt-5 flex items-center gap-3">
              {d.title}
              <span class="h-px flex-1 bg-line transition-all duration-500 group-hover:bg-clay"></span>
            </h3>
            <p class="text-sm text-stone mt-2 leading-relaxed">{d.text}</p>
            <span class="mt-4 inline-block font-sans uppercase tracking-widest text-[11px] text-clay group-hover:text-ink transition-colors">Explorar la guía →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════ CARRUSELES POR PAÍS ══════════ -->
  <GuideCarousel eyebrow="Todas nuestras guías de" title="Italia" guides={italia} cta={{ label: 'Ver Italia', href: '/destinos/italia' }} />
  <GuideCarousel eyebrow="Todas nuestras guías de" title="Francia" guides={francia} cta={{ label: 'Ver Francia', href: '/destinos/francia' }} />
  <GuideCarousel eyebrow="Todas nuestras guías de" title="España" guides={espana} cta={{ label: 'Ver España', href: '/destinos/espana' }} />

  <!-- ══════════ LIFESTYLE ══════════ -->
  <section class="bg-olive text-cream py-24 md:py-28 reveal">
    <div class="container-x grid md:grid-cols-2 gap-14 items-center">
      <div class="relative">
        <div class="aspect-[4/5] overflow-hidden">
          <img src={IMG.hotel} alt="Hotel con encanto" loading="lazy" class="w-full h-full object-cover" />
        </div>
        <div class="absolute -bottom-6 -right-6 hidden md:block w-40 aspect-square overflow-hidden border-4 border-olive">
          <img src={IMG.winery} alt="Experiencia local" loading="lazy" class="w-full h-full object-cover" />
        </div>
      </div>
      <div>
        <SectionHeading index="02" eyebrow={`${SITE.author} · Travel Lifestyle`} title="Más que guías:<br/>una forma de <span class='accent'>viajar</span>" light={true} />
        <p class="mt-6 text-cream/80 leading-relaxed">
          Para quienes quieren dar un paso más, {SITE.author} diseña viajes a medida, retiros de
          bienestar y experiencias cuidadas de principio a fin. Estancias escogidas, encuentros
          con productores locales y un ritmo pensado para disfrutar, no para correr.
        </p>
        <div class="mt-8 grid grid-cols-3 gap-6 border-t border-cream/20 pt-8">
          <div><p class="font-serif text-2xl">Estancias</p><p class="text-xs text-cream/60 mt-1">Hoteles y villas con alma</p></div>
          <div><p class="font-serif text-2xl">Experiencias</p><p class="text-xs text-cream/60 mt-1">Cultura y gastronomía</p></div>
          <div><p class="font-serif text-2xl">A medida</p><p class="text-xs text-cream/60 mt-1">Tu viaje, para ti</p></div>
        </div>
        <a href="/lifestyle" class="btn-solid-light mt-9">Descubrir el servicio</a>
      </div>
    </div>
  </section>

  <!-- ══════════ GUÍA DESTACADA ══════════ -->
  {featured && (
    <section class="relative py-36 md:py-44 reveal overflow-hidden">
      <img src={featured.data.gallery?.[0] ?? featured.data.cover} alt={featured.data.title}
        class="absolute inset-0 w-full h-full object-cover" />
      <div class="hero-overlay"></div>
      <div class="absolute inset-0 bg-ink/35"></div>
      <div class="container-x relative z-10 text-cream text-center max-w-2xl mx-auto">
        <p class="eyebrow-line centered text-cream/75 mb-5 text-shadow-soft">Guía destacada</p>
        <h2 class="font-serif text-5xl md:text-6xl text-shadow-hero">{featured.data.title}</h2>
        <p class="mt-5 text-cream/90 leading-relaxed text-shadow-soft">{featured.data.subtitle}</p>
        <a href={`/guias/${featured.slug}`} class="btn-solid-light mt-9">Ver la guía completa</a>
      </div>
    </section>
  )}

  <!-- ══════════ EL DIARIO ══════════ -->
  <section class="container-x py-24 md:py-28 reveal">
    <SectionHeading index="03" eyebrow="El Diario del Viajero" title="Historias para <span class='accent'>viajar despacio</span>" cta={{ label: 'Leer todas', href: '/diario' }} />
    <div class="grid md:grid-cols-3 gap-10 mt-14">
      {articles.slice(0, 3).map((a) => <ArticleCard article={a} />)}
    </div>
  </section>

  <Newsletter />
</Base>
