---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GuideCover from '../../components/GuideCover.astro';
import GuideBook from '../../components/GuideBook.astro';
import { SITE } from '../../data/site.js';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="Guías de viaje" description="Guías de viaje creadas a partir de experiencias reales: rutas, hoteles, restaurantes, lugares especiales y recomendaciones prácticas.">
  <section class="container-x pt-36 pb-10 text-center">
    <h1 class="font-serif uppercase tracking-[0.14em] text-4xl md:text-5xl">Guías de viaje</h1>
    <p class="mt-6 max-w-2xl mx-auto text-stone leading-relaxed md:text-lg">
      Guías de viaje creadas a partir de experiencias reales y cuidadosamente seleccionadas.
      Rutas, hoteles, restaurantes, lugares especiales y recomendaciones prácticas para descubrir
      cada destino y convertir cada viaje en un recuerdo especial.
    </p>
  </section>

  {guides.map((g, i) => (
    <section id={g.slug} class:list={['py-20 md:py-24 scroll-mt-16', i % 2 === 0 ? 'bg-sand' : '']}>
      <div class="container-x grid lg:grid-cols-[minmax(0,300px)_minmax(0,1fr)] gap-12 lg:gap-20 items-start">
        <!-- Portada + compra -->
        <div class="w-[min(72vw,300px)] mx-auto lg:mx-0">
          <GuideCover guide={g} />
          <h2 class="font-serif text-3xl mt-8 text-center">Guía de {g.data.title}</h2>
          {g.data.subtitle && <p class="text-sm text-stone mt-2 text-center leading-relaxed">{g.data.subtitle}</p>}
          <p class="font-serif text-2xl mt-4 text-center">{g.data.price} {SITE.currency}</p>
          <a href={g.data.buyUrl} class="btn-dark w-full mt-5" data-buy>Añadir a la cesta</a>
          <p class="text-[11px] text-stone text-center mt-3">Guía digital en PDF · entrega inmediata por email</p>
        </div>

        <!-- Libro hojeable -->
        <div class="lg:pt-4">
          <p class="eyebrow text-center mb-6">Hojea las primeras páginas</p>
          <GuideBook guide={g} />
        </div>
      </div>
    </section>
  ))}
</Base>

<script>
  // Cesta demo — sustituir por la pasarela real de Elena (Lemon Squeezy / Stripe)
  document.querySelectorAll<HTMLAnchorElement>('[data-buy]').forEach((b) => {
    b.addEventListener('click', (e) => {
      if (b.getAttribute('href') === '#') {
        e.preventDefault();
        b.textContent = '✓ Añadida a la cesta';
        setTimeout(() => (b.textContent = 'Añadir a la cesta'), 2200);
      }
    });
  });
</script>
