---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GuideCard from '../../components/GuideCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { IMG } from '../../lib/img.js';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const regions = ['Todas', 'Italia', 'Francia', 'España', 'Resto de Europa'];
const allStyles = [...new Set(guides.flatMap((g) => g.data.styles))];
---

<Base title="Todas las guías" description="Explora todas las guías de viaje digitales: itinerarios cuidados para descubrir Europa despacio.">
  <!-- Cabecera -->
  <section class="relative h-[52vh] min-h-[380px] flex items-center justify-center text-center overflow-hidden">
    <img src={IMG.tuscany1} alt="Guías de viaje" class="absolute inset-0 w-full h-full object-cover kenburns" />
    <div class="hero-overlay"></div>
    <div class="relative z-10 text-cream container-x">
      <p class="eyebrow-line centered text-cream/75 mb-4 text-shadow-soft">La colección completa</p>
      <h1 class="font-serif text-5xl md:text-7xl text-shadow-hero">Nuestras <span class="italic" style="color:#EBD4B8">guías</span></h1>
      <p class="mt-4 max-w-xl mx-auto text-cream/90 text-shadow-soft">Itinerarios día a día, mapas, hoteles y experiencias para viajar despacio.</p>
    </div>
  </section>

  <!-- Filtros -->
  <section class="container-x py-14">
    <div class="flex flex-col gap-6 mb-12">
      <div class="flex flex-wrap gap-2" data-filter-group="region">
        {regions.map((r, i) => (
          <button class:list={['filter-btn px-5 py-2 font-sans uppercase tracking-widest text-[11px] border transition-colors', i === 0 ? 'bg-ink text-cream border-ink' : 'border-line text-stone hover:border-ink hover:text-ink']} data-value={r}>{r}</button>
        ))}
      </div>
      <div class="flex flex-wrap gap-2" data-filter-group="style">
        <button class="filter-btn-style px-4 py-1.5 font-sans uppercase tracking-widest text-[10px] border border-ink bg-ink text-cream" data-value="Todos">Todos los estilos</button>
        {allStyles.map((s) => (
          <button class="filter-btn-style px-4 py-1.5 font-sans uppercase tracking-widest text-[10px] border border-line text-stone hover:border-ink hover:text-ink transition-colors" data-value={s}>{s}</button>
        ))}
      </div>
    </div>

    <div id="guide-grid" class="grid grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-14">
      {guides.map((g) => (
        <div class="guide-item w-full" data-region={g.data.region} data-styles={g.data.styles.join('|')}>
          <GuideCard guide={g} width="w-full" />
        </div>
      ))}
    </div>
    <p id="empty-msg" class="hidden text-center text-stone py-16 font-serif text-2xl">No hay guías con estos filtros todavía.</p>
  </section>

  <Newsletter />
</Base>

<script>
  let region = 'Todas';
  let style = 'Todos';
  const items = [...document.querySelectorAll('.guide-item')];
  const empty = document.getElementById('empty-msg');

  function apply() {
    let visible = 0;
    items.forEach((el) => {
      const okR = region === 'Todas' || el.dataset.region === region;
      const okS = style === 'Todos' || (el.dataset.styles || '').split('|').includes(style);
      const show = okR && okS;
      el.classList.toggle('hidden', !show);
      if (show) visible++;
    });
    empty?.classList.toggle('hidden', visible > 0);
  }

  function wire(groupSel, activeClasses, onPick) {
    document.querySelectorAll(groupSel).forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll(groupSel).forEach((b) => {
          b.classList.remove('bg-ink', 'text-cream', 'border-ink');
          b.classList.add('border-line', 'text-stone');
        });
        btn.classList.add('bg-ink', 'text-cream', 'border-ink');
        btn.classList.remove('border-line', 'text-stone');
        onPick(btn.dataset.value);
        apply();
      });
    });
  }
  wire('.filter-btn', '', (v) => (region = v));
  wire('.filter-btn-style', '', (v) => (style = v));
</script>
