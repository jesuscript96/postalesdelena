---
import { SITE } from '../data/site.js';
const { guide, width = 'w-[280px] md:w-[320px]' } = Astro.props;
const { data, slug } = guide;
const href = `/guias/${slug}`;
---
<article class:list={['group', width]}>
  <a href={href} class="block overflow-hidden bg-sand">
    <div class="aspect-[3/4] overflow-hidden">
      <img
        src={data.cover}
        alt={data.title}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-[1.2s] ease-slow group-hover:scale-105"
      />
    </div>
  </a>
  <div class="pt-4 flex items-start justify-between gap-4">
    <div>
      <p class="eyebrow">{data.country}</p>
      <h3 class="font-serif text-xl mt-1 leading-snug">
        <a href={href} class="link-underline">{data.title}</a>
      </h3>
      <p class="text-xs text-stone mt-1">{data.duration} · {data.bestWhen}</p>
    </div>
    <p class="font-serif text-lg whitespace-nowrap">{SITE.currency}{data.price}</p>
  </div>
  <a href={href} class="mt-3 inline-block font-sans uppercase tracking-widest text-[11px] text-clay hover:text-ink">Ver la guía →</a>
</article>
