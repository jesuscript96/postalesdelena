---
import GuideCard from './GuideCard.astro';
import SectionHeading from './SectionHeading.astro';
const { eyebrow, title, guides, cta, index } = Astro.props;
---
<section class="container-x py-16 md:py-20 reveal">
  <SectionHeading index={index} eyebrow={eyebrow} title={title} cta={cta} />
  <p class="eyebrow mt-4 mb-6 md:hidden">Desliza para ver todas →</p>
  <div class="carousel no-scrollbar mt-10">
    {guides.map((g) => <GuideCard guide={g} />)}
  </div>
</section>
