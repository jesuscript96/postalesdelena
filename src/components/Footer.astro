---
import { SITE, FOOTER } from '../data/site.js';
const year = new Date().getFullYear();
const socials = Object.entries(SITE.social).filter(([, v]) => v);
---

<!-- Pie minimalista: enlaces · boletín · redes / línea / copyright y legales -->
<footer class="bg-cream text-ink border-t border-line mt-24">
  <div class="container-x py-12 flex flex-col lg:flex-row lg:items-center gap-10 lg:gap-14">
    <nav class="flex flex-wrap gap-x-12 gap-y-4">
      {FOOTER.main.map((l) => (
        <a href={l.href} class="font-sans uppercase tracking-[0.12em] text-[12px] link-underline">{l.label}</a>
      ))}
    </nav>

    <form class="lg:ml-auto flex items-end border-b border-ink/50 w-full max-w-sm" data-newsletter>
      <label class="sr-only" for="footer-email">Correo electrónico</label>
      <input id="footer-email" type="email" required placeholder="Suscríbete al boletín"
        class="bg-transparent flex-1 py-2 text-[12px] uppercase tracking-[0.12em] placeholder-ink/80 outline-none" />
      <button class="font-sans uppercase tracking-[0.12em] text-[12px] py-2 pl-4 hover:text-clay">Enviar</button>
    </form>

    <div class="flex gap-6">
      {socials.map(([name, url]) => (
        <a href={url} target="_blank" rel="noopener" class="font-sans uppercase tracking-[0.12em] text-[12px] link-underline">{name}</a>
      ))}
    </div>
  </div>

  <div class="border-t border-line">
    <p class="container-x py-8 text-center text-[12px] text-stone leading-loose">
      <span>© {year}, {SITE.displayName}</span>
      {FOOTER.legal.map((l) => (
        <>
          <span class="mx-2" aria-hidden="true">·</span>
          <a href={l.href} class="hover:text-ink">{l.label}</a>
        </>
      ))}
    </p>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((f) =>
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = f.querySelector('input');
      if (input) { input.value = ''; input.placeholder = '¡Gracias por suscribirte!'; }
    })
  );
</script>
