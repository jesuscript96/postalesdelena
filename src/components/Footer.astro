---
import { SITE, FOOTER } from '../data/site.js';
const year = new Date().getFullYear();
const socials = Object.entries(SITE.social).filter(([, v]) => v);
---

<footer class="bg-ink text-cream/80 mt-24">
  <div class="container-x py-20">
    <div class="grid md:grid-cols-[1.4fr_1fr_1fr_1fr] gap-12">
      <!-- Marca + newsletter -->
      <div>
        <div class="font-serif tracking-[0.15em] text-lg leading-tight text-cream">
          {SITE.logoLines.map((l) => <span class="block">{l}</span>)}
        </div>
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-cream/70">
          {SITE.tagline}. Únete y recibe rincones, hoteles con alma e itinerarios cuidados en tu correo.
        </p>
        <form class="mt-6 flex border-b border-cream/30" onsubmit="return false">
          <input type="email" required placeholder="Tu correo" class="bg-transparent flex-1 py-2 text-sm placeholder-cream/40 outline-none" />
          <button class="font-sans uppercase tracking-widest text-[11px] py-2 hover:text-clay">Unirme</button>
        </form>
      </div>

      <div>
        <h4 class="eyebrow text-cream/50 mb-5">Explorar</h4>
        <ul class="space-y-3 text-sm">
          {FOOTER.explore.map((l) => <li><a href={l.href} class="link-underline hover:text-cream">{l.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h4 class="eyebrow text-cream/50 mb-5">Ayuda</h4>
        <ul class="space-y-3 text-sm">
          {FOOTER.help.map((l) => <li><a href={l.href} class="link-underline hover:text-cream">{l.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h4 class="eyebrow text-cream/50 mb-5">Legal</h4>
        <ul class="space-y-3 text-sm">
          {FOOTER.legal.map((l) => <li><a href={l.href} class="link-underline hover:text-cream">{l.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-cream/15 flex flex-col md:flex-row items-center justify-between gap-6">
      <p class="text-xs text-cream/50">© {year} {SITE.name} · {SITE.author}. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        {socials.map(([name, url]) => (
          <a href={url} target="_blank" rel="noopener" class="font-sans uppercase tracking-widest text-[11px] text-cream/60 hover:text-cream">{name}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
