---
// Encabezado de sección editorial con número de índice y hairline.
const {
  index,           // "01"
  eyebrow,
  title,
  align = 'left',  // 'left' | 'center'
  cta,             // { label, href }
  light = false,
} = Astro.props;
const tone = light ? 'text-cream' : 'text-ink';
const sub = light ? 'text-cream/60' : 'text-stone';
---
{align === 'center' ? (
  <div class="text-center max-w-2xl mx-auto">
    {index && <span class={`font-serif text-sm ${light ? 'text-clay' : 'text-clay'} tracking-widest`}>{index}</span>}
    {eyebrow && <p class:list={['eyebrow-line centered mt-3 mb-4', sub]}>{eyebrow}</p>}
    <h2 class:list={['font-serif text-4xl md:text-5xl leading-tight', tone]} set:html={title} />
  </div>
) : (
  <div class="flex items-end justify-between gap-6">
    <div>
      <div class="flex items-center gap-4">
        {index && <span class="font-serif text-sm text-clay tracking-widest">{index}</span>}
        {index && <span class:list={['h-px w-10', light ? 'bg-cream/40' : 'bg-line']} />}
        {eyebrow && <p class:list={['eyebrow', sub]}>{eyebrow}</p>}
      </div>
      <h2 class:list={['font-serif text-4xl md:text-5xl leading-tight mt-4', tone]} set:html={title} />
    </div>
    {cta && (
      <a href={cta.href} class:list={['hidden md:inline whitespace-nowrap font-sans uppercase tracking-widest text-[12px] link-underline pb-1', tone]}>{cta.label}</a>
    )}
  </div>
)}
