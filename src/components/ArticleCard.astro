---
// Tarjeta del Diario: foto vertical y debajo solo el título.
const { article } = Astro.props;
const { data, slug } = article;
const href = `/diario/${slug}`;
---
<a href={href} class="group block">
  <div class="aspect-[3/4] overflow-hidden bg-sand">
    <img src={data.cover} alt={data.title} loading="lazy"
      class="w-full h-full object-cover transition-transform duration-[1.2s] ease-slow group-hover:scale-105" />
  </div>
  <h3 class="font-serif text-xl md:text-[1.4rem] leading-snug mt-4 text-center">
    <span class="link-underline">{data.title}</span>
  </h3>
</a>
