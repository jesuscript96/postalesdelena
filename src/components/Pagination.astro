---
// Paginación del Diario: 1 2 3 … 9 >
const { current, total } = Astro.props;
const url = (n) => (n === 1 ? '/diario' : `/diario/pagina/${n}`);

// Primeras páginas, las cercanas a la actual y la última; el resto con "…"
const shown = new Set([1, 2, 3, current - 1, current, current + 1, total].filter((n) => n >= 1 && n <= total));
const items = [];
[...shown].sort((a, b) => a - b).forEach((n, i, arr) => {
  if (i > 0 && n - arr[i - 1] > 1) items.push('…');
  items.push(n);
});
---
<nav class="bg-sand py-12 -mb-24" aria-label="Paginación">
  <ul class="flex items-center justify-center gap-7 font-sans text-[13px] text-ink/80">
    {current > 1 && (
      <li><a href={url(current - 1)} aria-label="Página anterior" class="hover:text-ink">‹</a></li>
    )}
    {items.map((it) =>
      it === '…' ? (
        <li aria-hidden="true">…</li>
      ) : (
        <li>
          <a
            href={url(it)}
            aria-current={it === current ? 'page' : undefined}
            class:list={['inline-block pb-1', it === current ? 'border-b border-ink text-ink' : 'hover:text-ink']}
          >{it}</a>
        </li>
      )
    )}
    {current < total && (
      <li><a href={url(current + 1)} aria-label="Página siguiente" class="hover:text-ink">›</a></li>
    )}
  </ul>
</nav>
