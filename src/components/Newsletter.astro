---
const {
  eyebrow = 'El Club · Simply Slow Mail',
  title = 'Únete al Club',
  text = 'Cada semana, un rincón con alma, un hotel que enamora y un itinerario para viajar despacio. Directo a tu correo.',
  dark = true,
} = Astro.props;
---
<section class:list={[dark ? 'bg-olive text-cream' : 'bg-sand text-ink', 'py-24 reveal']}>
  <div class="container-x max-w-2xl text-center">
    <p class:list={['eyebrow', dark ? 'text-cream/60' : '']}>{eyebrow}</p>
    <h2 class="font-serif text-4xl md:text-5xl mt-4">{title}</h2>
    <p class:list={['mt-5 leading-relaxed', dark ? 'text-cream/80' : 'text-stone']}>{text}</p>
    <form class="mt-8 flex max-w-md mx-auto border-b" class:list={[dark ? 'border-cream/40' : 'border-ink/30']} onsubmit="return false">
      <input type="email" required placeholder="Tu correo electrónico"
        class="bg-transparent flex-1 py-3 text-sm outline-none placeholder-current/50" />
      <button class="font-sans uppercase tracking-widest text-[11px] px-2 hover:opacity-70">Unirme →</button>
    </form>
    <p class:list={['text-xs mt-4', dark ? 'text-cream/50' : 'text-stone/70']}>Sin spam. Puedes darte de baja cuando quieras.</p>
  </div>
</section>
